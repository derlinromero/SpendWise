# Neon PostgreSQL: use the restricted spendwise_backend login, not the owner.
# See backend/sql/README.md. Preserve sslmode=require in the connection string.
DATABASE_URL=

# Clerk JWT verification. Copy the PEM public key from Clerk Dashboard > JWT
# Templates/keys. Keep the BEGIN/END lines; use a quoted multiline value locally.
CLERK_JWT_KEY=
# Optional but recommended: your Clerk issuer and audience values.
CLERK_ISSUER=
CLERK_AUDIENCE=
